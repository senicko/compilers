Grammar:

Rule 0     S' -> program
Rule 1     program -> statements
Rule 2     statements -> <empty>
Rule 3     statements -> statements statement
Rule 4     statement -> FOR ID = range statement
Rule 5     statement -> WHILE ( condition ) statement
Rule 6     statement -> IF ( condition ) statement ELSE statement  [precedence=nonassoc, level=2]
Rule 7     statement -> IF ( condition ) statement  [precedence=nonassoc, level=1]
Rule 8     statement -> { statements }
Rule 9     statement -> RETURN ;
Rule 10    statement -> RETURN value ;
Rule 11    statement -> CONTINUE ;
Rule 12    statement -> BREAK ;
Rule 13    statement -> PRINT values ;
Rule 14    statement -> assignment ;
Rule 15    condition -> expression NE expression
Rule 16    condition -> expression EQ expression
Rule 17    condition -> expression GE expression
Rule 18    condition -> expression LE expression
Rule 19    condition -> expression > expression
Rule 20    condition -> expression < expression
Rule 21    assignment -> reference assign_operator value
Rule 22    assign_operator -> DIVASSIGN
Rule 23    assign_operator -> MULASSIGN
Rule 24    assign_operator -> SUBASSIGN
Rule 25    assign_operator -> ADDASSIGN
Rule 26    assign_operator -> =
Rule 27    reference -> ID [ indices ]
Rule 28    reference -> ID
Rule 29    indices -> indices , index
Rule 30    indices -> index
Rule 31    index -> range
Rule 32    index -> expression
Rule 33    range -> expression : expression
Rule 34    expression -> special_function ( expression , expression )
Rule 35    expression -> special_function ( expression )
Rule 36    expression -> STRING
Rule 37    expression -> FLOATNUM
Rule 38    expression -> INTNUM
Rule 39    expression -> reference
Rule 40    expression -> ( expression )
Rule 41    expression -> expression '  [precedence=left, level=6]
Rule 42    expression -> - expression  [precedence=right, level=5]
Rule 43    expression -> expression DOTDIV expression  [precedence=left, level=4]
Rule 44    expression -> expression DOTMUL expression  [precedence=left, level=4]
Rule 45    expression -> expression DOTSUB expression  [precedence=left, level=3]
Rule 46    expression -> expression DOTADD expression  [precedence=left, level=3]
Rule 47    expression -> expression / expression  [precedence=left, level=4]
Rule 48    expression -> expression * expression  [precedence=left, level=4]
Rule 49    expression -> expression - expression  [precedence=left, level=3]
Rule 50    expression -> expression + expression  [precedence=left, level=3]
Rule 51    special_function -> ONES
Rule 52    special_function -> ZEROS
Rule 53    special_function -> EYE
Rule 54    value -> matrix
Rule 55    value -> expression
Rule 56    values -> values , value
Rule 57    values -> value
Rule 58    matrix -> [ rows ]
Rule 59    matrix -> [ expressions ]
Rule 60    rows -> rows , vector
Rule 61    rows -> vector
Rule 62    vector -> [ expressions ]
Rule 63    expressions -> expressions , expression
Rule 64    expressions -> expression

