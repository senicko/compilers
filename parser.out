Grammar:

Rule 0     S' -> program
Rule 1     program -> statements
Rule 2     statements -> <empty>
Rule 3     statements -> statements statement
Rule 4     statement -> FOR ID = range statement
Rule 5     statement -> WHILE ( expression ) statement
Rule 6     statement -> IF ( expression ) statement ELSE statement  [precedence=nonassoc, level=2]
Rule 7     statement -> IF ( expression ) statement  [precedence=nonassoc, level=1]
Rule 8     statement -> { statements }
Rule 9     statement -> RETURN ;
Rule 10    statement -> RETURN expression ;
Rule 11    statement -> CONTINUE ;
Rule 12    statement -> BREAK ;
Rule 13    statement -> PRINT expressions ;
Rule 14    statement -> assignment ;
Rule 15    assignment -> reference assign_operator expression
Rule 16    assign_operator -> DIVASSIGN
Rule 17    assign_operator -> MULASSIGN
Rule 18    assign_operator -> SUBASSIGN
Rule 19    assign_operator -> ADDASSIGN
Rule 20    assign_operator -> =
Rule 21    reference -> ID [ indices ]
Rule 22    reference -> ID
Rule 23    indices -> indices , index
Rule 24    indices -> index
Rule 25    index -> range
Rule 26    index -> expression
Rule 27    range -> expression : expression
Rule 28    expression -> special_function ( expression , expression )
Rule 29    expression -> special_function ( expression )
Rule 30    expression -> [ ]
Rule 31    expression -> [ expressions ]
Rule 32    expression -> STRING
Rule 33    expression -> FLOATNUM
Rule 34    expression -> INTNUM
Rule 35    expression -> reference
Rule 36    expression -> ( expression )
Rule 37    expression -> expression '  [precedence=left, level=7]
Rule 38    expression -> - expression  [precedence=right, level=6]
Rule 39    expression -> expression NE expression  [precedence=nonassoc, level=3]
Rule 40    expression -> expression EQ expression  [precedence=nonassoc, level=3]
Rule 41    expression -> expression GE expression  [precedence=nonassoc, level=3]
Rule 42    expression -> expression LE expression  [precedence=nonassoc, level=3]
Rule 43    expression -> expression > expression  [precedence=nonassoc, level=3]
Rule 44    expression -> expression < expression  [precedence=nonassoc, level=3]
Rule 45    expression -> expression DOTDIV expression  [precedence=left, level=5]
Rule 46    expression -> expression DOTMUL expression  [precedence=left, level=5]
Rule 47    expression -> expression DOTSUB expression  [precedence=left, level=4]
Rule 48    expression -> expression DOTADD expression  [precedence=left, level=4]
Rule 49    expression -> expression / expression  [precedence=left, level=5]
Rule 50    expression -> expression * expression  [precedence=left, level=5]
Rule 51    expression -> expression - expression  [precedence=left, level=4]
Rule 52    expression -> expression + expression  [precedence=left, level=4]
Rule 53    special_function -> ONES
Rule 54    special_function -> ZEROS
Rule 55    special_function -> EYE
Rule 56    expressions -> expressions , expression
Rule 57    expressions -> expression

Terminals, with rules where they appear:

'                    : 37
